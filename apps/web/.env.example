# Copy to .env.local and fill in, or run `vercel env pull .env.local` (every key lives on Vercel; a pull replaces the whole file).

# === App: its public origin. Vault links and webhooks are built from it (http://localhost:3000 locally, https://app.usepersona.dev on production and preview) ===
APP_URL=

# === Site: the landing and legal pages, their own app (http://localhost:3001 locally, https://usepersona.dev on production and preview) ===
NEXT_PUBLIC_SITE_URL=

# === Database: Postgres 15 or later ===
DATABASE_URL=
# PgBouncer in front of the database, production only (local and preview leave it empty). The app uses it when set; migrations always use DATABASE_URL
DATABASE_POOLED_URL=

# === Redis 6 or later: the chat channels' state (the Chat SDK), under keys that start with chat: ===
REDIS_URL=

# === Clerk: auth, with organizations on. Keys: `clerk env pull` or Dashboard -> API keys ===
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# === Autumn: plans, credits and payments, on top of Stripe. autumn.config.ts holds the plans, and each deploy sends them to the Autumn environment of its key (`pnpm autumn:push`). The sandbox key (am_sk_test_) here, on Development and on Preview; the live key (am_sk_live_) only on Production ===
AUTUMN_SECRET_KEY=

# === eve: the agent ===
# Model access through Vercel AI Gateway: `eve link` writes a short-lived VERCEL_OIDC_TOKEN to .env.local; re-run it when it expires.
# VERCEL_OIDC_TOKEN also authenticates the skills.sh API (lib/skills-sh.ts).
VERCEL_OIDC_TOKEN=
# Or set a gateway key instead:
# AI_GATEWAY_API_KEY=
# Signs the agent tokens the web channel takes (a long random secret you make)
AGENT_TOKEN_SECRET=

# === Skills hub: Discover on the Skills page, which lists skills.sh. skills.sh takes only a Vercel OIDC token: true where VERCEL_OIDC_TOKEN is set, false anywhere else. Read when the app builds ===
NEXT_PUBLIC_SKILLS_HUB_ENABLED=false

# === Secrets: seals every value in the secrets table (AES-256-GCM). 32 random bytes in base64: node -e 'console.log(require("crypto").randomBytes(32).toString("base64"))'. One value on Development and Preview (they share the dev database), its own on Production. A lost key loses every value ===
SECRETS_KEY=

# === Automations and webhooks: the schedule and the queue routes send it to the agent's own run and report routes, which refuse any call without it (a long random secret you make) ===
AUTOMATIONS_SECRET=

# === Supermemory: each persona's memory ===
SUPERMEMORY_API_KEY=

# === Composio: app integrations for agents ===
COMPOSIO_API_KEY=
COMPOSIO_WEBHOOK_SECRET=

# === Browser Use: cloud browsers for agents (cloud.browser-use.com -> API keys) ===
BROWSER_USE_API_KEY=

# === Files: one private bucket on any storage that speaks S3 (Cloudflare R2, AWS S3, MinIO), for every environment, like the database ===
# The storage's address. People's browsers, WhatsApp and the model provider open signed links to it, so it must answer on the internet over https.
# Cloudflare R2: https://<account id>.r2.cloudflarestorage.com with the region "auto". AWS S3: https://s3.<region>.amazonaws.com. MinIO: its public address.
# The bucket needs a CORS rule that lets the app's address PUT and GET with a content-type header: the browser uploads pictures and files straight to it
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FILES_BUCKET=

# Published files: the app shows one at FILES_PREVIEW_URL/<personaId>/<fileId>; the Worker serves the file itself at https://<personaId>.<PUBLISHED_FILES_DOMAIN>/<fileId>
# e.g. https://files.usepersona.dev/123/456 and worker is https://123.usepersona.site/456. Use a Cloudflare domain with a wildcard subdomain like *.usepersona.site.
FILES_PREVIEW_URL=
PUBLISHED_FILES_DOMAIN=

# === WhatsApp on Meta directly: the Meta app's secret, its system user token and webhook verify token, and the shared number (one number for every environment; leave the number empty to offer none) ===
META_APP_SECRET=
META_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
META_PHONE_NUMBER_ID=
META_PHONE_NUMBER=

# === Telegram: the shared bot (one bot for every environment, its webhook points at one of them; leave the token empty to offer none) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_NAME=
TELEGRAM_WEBHOOK_SECRET=

# === PostHog: product analytics, errors and replays (one project shared by the webapp, the landing and the docs; the host is a managed reverse proxy, so ad blockers do not drop events; leave the key empty to send nothing) ===
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

