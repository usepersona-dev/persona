  {
    "id": "data.runs.copy_old_runs",
    "label": "Copy schedule_runs and webhook_runs into runs",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "table",
        "name": "runs"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "copy the automation runs",
        "sql": "INSERT INTO \"public\".\"runs\" (\"id\", \"persona_id\", \"source\", \"title\", \"link_id\", \"schedule_id\", \"scheduled_for\", \"webhook_id\", \"status\", \"session_id\", \"result\", \"created_at\", \"claimed_at\", \"ended_at\") SELECT r.\"id\", s.\"persona_id\", 'automation', s.\"name\", s.\"link_id\", r.\"schedule_id\", r.\"scheduled_for\", NULL, r.\"status\", r.\"session_id\", r.\"result\", r.\"created_at\", r.\"claimed_at\", r.\"ended_at\" FROM \"public\".\"schedule_runs\" r JOIN \"public\".\"schedules\" s ON s.\"id\" = r.\"schedule_id\" ON CONFLICT DO NOTHING",
        "params": []
      },
      {
        "description": "copy the webhook runs",
        "sql": "INSERT INTO \"public\".\"runs\" (\"id\", \"persona_id\", \"source\", \"title\", \"link_id\", \"schedule_id\", \"scheduled_for\", \"webhook_id\", \"status\", \"session_id\", \"result\", \"created_at\", \"claimed_at\", \"ended_at\") SELECT r.\"id\", w.\"persona_id\", 'webhook', w.\"name\", w.\"link_id\", NULL, NULL, r.\"webhook_id\", r.\"status\", r.\"session_id\", r.\"result\", r.\"created_at\", r.\"created_at\", r.\"ended_at\" FROM \"public\".\"webhook_runs\" r JOIN \"public\".\"webhooks\" w ON w.\"id\" = r.\"webhook_id\" ON CONFLICT DO NOTHING",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "every old run is in runs",
        "sql": "SELECT NOT EXISTS (SELECT 1 FROM \"public\".\"schedule_runs\" o WHERE NOT EXISTS (SELECT 1 FROM \"public\".\"runs\" n WHERE n.\"id\" = o.\"id\")) AND NOT EXISTS (SELECT 1 FROM \"public\".\"webhook_runs\" o WHERE NOT EXISTS (SELECT 1 FROM \"public\".\"runs\" n WHERE n.\"id\" = o.\"id\")) AS \"result\"",
        "params": []
      }
    ]
  }
