        "sql": "CREATE TABLE \"public\".\"runs\" (\n  \"claimed_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"created_at\" timestamptz DEFAULT (now()) NOT NULL,\n  \"ended_at\" timestamptz,\n  \"id\" text NOT NULL,\n  \"link_id\" text,\n  \"persona_id\" text NOT NULL,\n  \"result\" jsonb,\n  \"schedule_id\" text,\n  \"scheduled_for\" timestamptz,\n  \"session_id\" text,\n  \"source\" text NOT NULL,\n  \"status\" text DEFAULT 'running' NOT NULL,\n  \"title\" text NOT NULL,\n  \"webhook_id\" text,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"runs_source_check_e052350f\" CHECK (\"source\" IN ('automation', 'webhook')),\n  CONSTRAINT \"runs_status_check_77fab0ab\" CHECK (\"status\" IN ('running', 'completed', 'failed'))\n)",
