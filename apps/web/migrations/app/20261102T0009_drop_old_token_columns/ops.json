        "objectType": "table",
        "name": "token_usage"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "drop the view \"token_usage\"",
        "sql": "DROP VIEW IF EXISTS \"public\".\"token_usage\""
      }
    ],
    "postcheck": [
      {
        "description": "verify the view \"token_usage\" is gone",
        "sql": "SELECT NOT EXISTS (SELECT 1 FROM \"pg_views\" WHERE \"schemaname\" = 'public' AND \"viewname\" = 'token_usage') AS \"result\""
      }
    ]
  },
