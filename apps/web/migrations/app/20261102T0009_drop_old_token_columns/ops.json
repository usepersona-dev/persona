[
  {
    "id": "data.public.usage.tokens",
    "label": "Copy the token columns of the last rows into \"tokens\" on \"usage\"",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "tokens",
        "table": "usage"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "copy the token columns into \"tokens\"",
        "sql": "UPDATE \"public\".\"usage\" SET \"tokens\" = jsonb_build_object('model', \"model\", 'provider', \"provider\", 'inputTokens', \"input_tokens\", 'cachedInputTokens', \"cached_input_tokens\", 'cacheWriteTokens', \"cache_write_tokens\", 'outputTokens', \"output_tokens\", 'reasoningTokens', \"reasoning_tokens\") WHERE \"tokens\" IS NULL AND \"model\" IS NOT NULL"
      }
    ],
    "postcheck": [
      {
        "description": "verify every row with a model has \"tokens\"",
        "sql": "SELECT NOT EXISTS (SELECT 1 FROM \"public\".\"usage\" WHERE \"tokens\" IS NULL AND \"model\" IS NOT NULL) AS \"result\""
      }
    ]
  },
  {
    "id": "view.public.token_usage.drop",
    "label": "Drop the view \"token_usage\"",
    "operationClass": "destructive",
    "target": {
      "id": "postgres",
      "details": {
