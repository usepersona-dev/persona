  {
    "id": "data.public.usage.credits",
    "label": "Count usage in credits of $0.20",
    "operationClass": "data",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "column",
        "name": "credits",
        "table": "usage"
      }
    },
    "precheck": [],
    "execute": [
      {
        "description": "count usage in credits of $0.20, keeping its market cost in its tokens",
        "sql": "UPDATE \"public\".\"usage\" SET \"tokens\" = CASE WHEN \"tokens\" IS NULL THEN NULL ELSE \"tokens\" || jsonb_build_object('marketCost', \"credits\"::text) END, \"credits\" = \"credits\" / 0.2"
      }
    ],
    "postcheck": []
  }
]